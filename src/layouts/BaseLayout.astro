---
import StyleChooser from '../components/StyleChooser.astro';
import InteractionEffects from '../components/InteractionEffects.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/prototype.css';
import '../styles/interactions.css';
import '../styles/hero.css';

interface Props {
  title?: string;
}

const { title = 'HuiYuan' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-style="minimal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const saved = JSON.parse(localStorage.getItem('blog-style') || 'null');
        if (saved && ['expressive', 'minimal'].includes(saved.style)) {
          document.documentElement.dataset.style = saved.style;
          document.documentElement.dataset.styleRemembered = 'true';
        }
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div id="site-surface" class:list={["site-surface", {"has-hero": Astro.url.pathname === "/"}]}>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
    </div>
    <StyleChooser />
    <InteractionEffects />
  </body>
</html>

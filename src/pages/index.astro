---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).filter(p => ['agent-swarm','langchain-end'].includes(p.id));
const topics = [['时代的理解','Understanding our times'],['Agent 的理解','Understanding agents'],['研究生生活','Graduate life'],['领导力思考','Thoughts on leadership'],['本科生活','Undergraduate life'],['碎碎念','Notes & thoughts']];
---
<BaseLayout title="辉远 · 首页原型">
<section class="hero"><div class="eyebrow"><span data-lang="zh">个人站点 / 首页原型 01</span><span data-lang="en">PERSONAL SITE / HOMEPAGE PROTOTYPE 01</span></div><h1>辉远<span aria-hidden="true">↗</span></h1><p class="meaning"><span data-lang="zh">普惠众生，利益长远。</span><span data-lang="en">For the benefit of all, for the long term.</span></p><p class="placeholder"><span data-lang="zh">短简介待补充。这里留给你自己的声音。</span><span data-lang="en">A short introduction will go here, in your own words.</span></p><div class="hero-rule"><span>01 — 06</span><span data-lang="zh">向下探索 ↓</span><span data-lang="en">EXPLORE BELOW ↓</span></div></section>
<section class="featured-grid" aria-label="Featured entries">
<article id="resume" class="feature-card"><small>01 / RESUME</small><h2><span data-lang="zh">简历</span><span data-lang="en">Resume</span></h2><p><span data-lang="zh">公开内容与下载文件待提供。</span><span data-lang="en">Public details and download pending.</span></p><span class="pending"><span data-lang="zh">待确认 ↗</span><span data-lang="en">Pending confirmation ↗</span></span></article>
<article id="projects" class="feature-card"><small>02 / PROJECTS</small><h2><span data-lang="zh">精选开源项目</span><span data-lang="en">Selected open source</span></h2><p><span data-lang="zh">最自豪的作品，由你来选。</span><span data-lang="en">Your proudest work. Selection pending.</span></p><span class="pending"><span data-lang="zh">精选名单待提供 ↗</span><span data-lang="en">Selection pending ↗</span></span></article>
<article id="blog" class="feature-card"><small>03 / BLOG</small><h2><span data-lang="zh">文章</span><span data-lang="en">Writing</span></h2><p><span data-lang="zh">已有正式文章，供原型阅读；精选身份待确认。</span><span data-lang="en">Existing published writing; featured selection pending.</span></p>{posts.map(p=><a class="article-link" href={`/posts/${p.id}/`}><span data-lang="zh">{p.data.title}</span><span data-lang="en">{p.data.titleEn}</span><span aria-hidden="true">↗</span></a>)}</article>
</section>
<section id="toolkit" class="toolkit"><div class="section-title"><h2>Toolkit</h2><a href="#toolkit-details"><span data-lang="zh">查看 Toolkit 原型 ↓</span><span data-lang="en">Explore Toolkit preview ↓</span></a></div><div id="toolkit-details" class="toolkit-grid"><article><small>TOOLS / PLUGINS / SOFTWARE</small><h3><span data-lang="zh">趁手的工具</span><span data-lang="en">Tools worth keeping</span></h3><p><span data-lang="zh">工具、插件与软件名单待确认。</span><span data-lang="en">Tools, plugins and software selection pending.</span></p></article><article><small>CODEX / GPT</small><h3><span data-lang="zh">经验与技巧</span><span data-lang="en">Experience & techniques</span></h3><p><span data-lang="zh">「使用网页版的 Codex 的技巧」</span><span data-lang="en">Codex web tips — title awaiting translation</span></p><span class="pending"><span data-lang="zh">待写 · 尚无正文</span><span data-lang="en">Planned · No article yet</span></span></article></div></section>
<section class="perspectives"><div class="section-title"><h2><span data-lang="zh">想法，慢慢展开。</span><span data-lang="en">Room for longer thoughts.</span></h2><small>06 / PERSPECTIVES</small></div>{topics.map(([zh,en],i)=><article class="topic"><span class="topic-number">0{i+1}</span><h3><span data-lang="zh">{zh}</span><span data-lang="en">{en}</span></h3><p><span data-lang="zh">文章归属与内容待确认</span><span data-lang="en">Articles and grouping pending</span></p><span aria-hidden="true">↗</span></article>)}</section>
</BaseLayout>

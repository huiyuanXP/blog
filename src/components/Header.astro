---
import { ui } from '../i18n/translations';
---

<header class="prototype-header"><a class="brand" href="/">惠远<span class="brand-dot">↗</span></a>
<nav aria-label="Main navigation"><a href="/">Home</a><a href="/#projects">Projects</a><a href="/#blog">Blog</a><a href="/#toolkit">Toolkit</a><a href="/#resume">Resume</a></nav>
<div class="header-controls"><button id="lang-toggle" aria-label="切换语言 / Change language">ZH / EN</button><button id="style-toggle"><span data-lang="zh">风格</span><span data-lang="en">Style</span></button><a href="/#contact"><span data-lang="zh">联系 ↗</span><span data-lang="en">Contact ↗</span></a></div></header>

<script>
  function initLang() {
    let saved = 'zh';
    try { saved = localStorage.getItem('lang') || 'zh'; } catch {}
    document.documentElement.lang = saved === 'en' ? 'en' : 'zh-CN';
    if (saved === 'en') {
      document.documentElement.classList.add('lang-en');
    }
  }

  function toggleLang() {
    const html = document.documentElement;
    const isEn = html.classList.toggle('lang-en');
    html.lang = isEn ? 'en' : 'zh-CN';
    try { localStorage.setItem('lang', isEn ? 'en' : 'zh'); } catch {}
  }

  initLang();

  document.getElementById('lang-toggle')?.addEventListener('click', toggleLang);

  document.addEventListener('astro:after-swap', () => {
    initLang();
    document.getElementById('lang-toggle')?.addEventListener('click', toggleLang);
  });
</script>
